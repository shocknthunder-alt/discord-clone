datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  memberships          Membership[]
  messages             Message[]
  messageReactions     MessageReaction[]
  ownedServers         Server[]         @relation("ServerOwner")
  directMessages       DirectMessage[]
  triviaScores         TriviaScore[]
  dmConversationsAsA   DmConversation[] @relation("DmUserA")
  dmConversationsAsB   DmConversation[] @relation("DmUserB")
}

model DmConversation {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA    User            @relation("DmUserA", fields: [userAId], references: [id])
  userB    User            @relation("DmUserB", fields: [userBId], references: [id])
  messages DirectMessage[]

  @@unique([userAId, userBId])
}

model DirectMessage {
  id             String    @id @default(cuid())
  content        String
  imageUrl       String?
  conversationId String
  authorId       String
  createdAt      DateTime  @default(now())
  editedAt       DateTime?

  conversation DmConversation @relation(fields: [conversationId], references: [id])
  author       User           @relation(fields: [authorId], references: [id])
}

model Server {
  id         String   @id @default(cuid())
  name       String
  iconUrl    String?
  ownerId    String
  owner      User     @relation("ServerOwner", fields: [ownerId], references: [id])
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())

  memberships   Membership[]
  customEmojis  CustomEmoji[]
  textChannels  TextChannel[]
  voiceChannels VoiceChannel[]
}

// SQLite has no native enum support in Prisma; role is "OWNER" | "MEMBER".
model Membership {
  id       String   @id @default(cuid())
  userId   String
  serverId String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  server Server @relation(fields: [serverId], references: [id])

  @@unique([userId, serverId])
}

model TextChannel {
  id            String   @id @default(cuid())
  name          String
  backgroundUrl String?
  serverId      String
  position      Int      @default(0)
  // "text" (normal) or "trivia" (the Trivia Bot listens in this channel)
  type          String   @default("text")
  createdAt     DateTime @default(now())

  server   Server    @relation(fields: [serverId], references: [id])
  messages Message[]
}

model Message {
  id            String    @id @default(cuid())
  content       String
  imageUrl      String?
  textChannelId String
  authorId      String
  replyToId     String?
  createdAt     DateTime  @default(now())
  editedAt      DateTime?

  textChannel TextChannel @relation(fields: [textChannelId], references: [id])
  author      User        @relation(fields: [authorId], references: [id])
  replyTo     Message?    @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]   @relation("MessageReplies")
  reactions   MessageReaction[]
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model VoiceChannel {
  id            String  @id @default(cuid())
  name          String
  backgroundUrl String?
  serverId      String
  position      Int     @default(0)

  server Server @relation(fields: [serverId], references: [id])
}

model CustomEmoji {
  id        String   @id @default(cuid())
  serverId  String
  name      String
  imageUrl  String
  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name])
}

model TriviaScore {
  id       String @id @default(cuid())
  serverId String
  userId   String
  points   Int    @default(0)
  correct  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
}
