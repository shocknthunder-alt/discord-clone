{
  "name": "shmirka-desktop",
  "version": "1.6.1",
  "private": true,
  "description": "ШмиркаТа — desktop app (Electron shell with the built client inside)",
  "main": "main.js",
  "author": "ШмиркаТа",
  "scripts": {
    "start": "node start.mjs",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "bg.shmirka.desktop",
    "npmRebuild": false,
    "afterPack": "after-pack.js",
    "productName": "ШмиркаТа",
    "files": [
      "main.js",
      "preload.js",
      "globalKeys.js",
      "appAudio.js",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Shmirka-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shocknthunder-alt",
        "repo": "discord-clone",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "loopback-capture": "^4.0.0",
    "uiohook-napi": "^1.5.5"
  }
}
