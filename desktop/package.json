{
  "name": "shmirka-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "ШмиркаТа — desktop app (Electron shell with the built client inside)",
  "main": "main.js",
  "author": "ШмиркаТа",
  "scripts": {
    "build:client": "node build-client.mjs",
    "start": "npm run build:client && node start.mjs",
    "dist": "npm run build:client && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "bg.shmirka.desktop",
    "productName": "ШмиркаТа",
    "files": ["main.js", "preload.js", "client-dist/**/*"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
